# Database
DATABASE_URL=mysql+pymysql://root:password@localhost/whatsbot

# License Server
LICENSE_SERVER_URL=https://lic.proxpanel.com
LICENSE_KEY=
SITE_DOMAIN=example.com
LICENSE_CHECK_ENABLED=true

# Bot Info
BOT_VERSION=1.0.0

# Store Information
STORE_NAME=Librairie Memoires
STORE_LOCATION=Tripoli, Lebanon
STORE_PHONE=+961 6 123456
STORE_WEBSITE=https://example.com
STORE_HOURS=Mon-Sat: 9AM-8PM
CURRENCY=LBP

# ProxSMS WhatsApp API
WHATSAPP_API_URL=https://proxsms.com/api/v1/send/whatsapp
WHATSAPP_ACCOUNT_ID=your_account_id
WHATSAPP_SEND_SECRET=your_send_secret
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_MODEL=claude-3-haiku-20240307
ANTHROPIC_MAX_TOKENS=500

# Brains ERP API
BRAINS_API_BASE=http://localhost:5000/api
API_TIMEOUT_SECONDS=30
API_RETRY_ATTEMPTS=3

# App Settings
DEBUG=false
HOST=0.0.0.0
PORT=8000
